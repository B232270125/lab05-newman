{
  "info": {
    "name": "Lab05 Public API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /users (jsonplaceholder)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const users = pm.response.json();",
              "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Хариу нь массив', function () { pm.expect(users).to.be.an('array'); });",
              "pm.test('Эхний хэрэглэгчийн нэр Leanne Graham', function () { pm.expect(users[0].name).to.eql('Leanne Graham'); });"
            ]
          }
        }
      ]
    }
  ]
}